# Site
NEXT_PUBLIC_SITE_URL=https://splitbiller.com

# PostHog — project API key from https://app.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=
# US cloud default; use https://eu.i.posthog.com for EU
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Also turn on Session replay in PostHog → Project settings → Session replay

# Turso — stores feedback and feature requests only (never expense data).
# Create with: turso db create splitbiller-feedback && turso db tokens create splitbiller-feedback
# Server-only: do NOT prefix with NEXT_PUBLIC_. Without these, dev falls back to a local .turso-dev.db file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Any long random string; used to hash IPs for rate limiting (raw IPs are never stored)
FEEDBACK_IP_SALT=

# Homepage promo video (Cloudflare R2 public URL). Optional: defaults to the bundled R2 object.
# NEXT_PUBLIC_PROMO_VIDEO_URL=https://your-domain.example/video.mp4
